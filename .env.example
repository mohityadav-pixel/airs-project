# ─────────────────────────────────────────────────────────────
# AIRS — environment configuration
# Copy to .env and fill in. NEVER commit .env.
# ─────────────────────────────────────────────────────────────

# ---- Runtime ----
AIRS_ENV=development
AIRS_LOG_LEVEL=INFO

# "live"  -> only real upstream API data is served (recommended)
# "demo"  -> deterministic synthetic data, clearly labelled DEMO in the UI
# "auto"  -> live, falling back to last-known-good cache, then demo (labelled)
AIRS_DATA_MODE=live

# ---- Database ----
# Production: postgresql+psycopg://airs:airs@localhost:5432/airs
# Local dev fallback: sqlite+pysqlite:///./data/airs.sqlite3
DATABASE_URL=postgresql+psycopg://airs:airs@localhost:5432/airs

# ---- Security ----
# Generate with: python -c "import secrets;print(secrets.token_urlsafe(48))"
AIRS_SECRET_KEY=change-me-please-generate-a-real-secret
AIRS_ACCESS_TOKEN_MINUTES=120
AIRS_CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173

# ---- Upstream data providers ----
# https://aqicn.org/data-platform/token/
WAQI_TOKEN=
# https://openweathermap.org  (API keys tab)
OPENWEATHER_API_KEY=
# Optional: https://developer.tomtom.com  (traffic flow)
TOMTOM_API_KEY=

# ---- AI ----
# https://aistudio.google.com/apikey
GEMINI_API_KEY=
GEMINI_MODEL=gemini-3.8-flash

# ---- Frontend (Vite; only VITE_* reach the browser — never put secrets here) ----
VITE_API_BASE_URL=http://localhost:8000
# https://explore.openaq.org/register (free) — live station data for India
OPENAQ_API_KEY=
